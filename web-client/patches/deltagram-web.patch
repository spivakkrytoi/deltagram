+// Animated DeltaGram avatar rings. Implemented as a masked conic-gradient
+// border so every avatar size gets a crisp ring without shipping megabytes of
+// Lottie per frame.
+
+.dg-avatar-frame {
+  position: absolute;
+  z-index: 4;
+  inset: 0;
+  padding: 7%;
+  border-radius: 50%;
+  pointer-events: none;
+
+  background: conic-gradient(from 0deg, #37a6ff, #7cd8ff, #2b5cff, #37a6ff);
+
+  mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
+  mask-composite: exclude;
+  /* stylelint-disable-next-line property-no-vendor-prefix */
+  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
+  /* stylelint-disable-next-line property-no-vendor-prefix */
+  -webkit-mask-composite: xor;
+
+  filter: drop-shadow(0 0 0.375rem rgba(55, 166, 255, 0.55));
+
+  animation: dg-frame-spin 7s linear infinite;
+  will-change: transform;
+}
+
+.dg-avatar-frame--blue {
+  background: conic-gradient(from 0deg, #37a6ff, #7cd8ff, #2b5cff, #37a6ff);
+  filter: drop-shadow(0 0 0.375rem rgba(55, 166, 255, 0.6));
+}
+
+.dg-avatar-frame--fire {
+  background: conic-gradient(from 0deg, #ffd25f, #ff7a18, #ff2d00, #ff9d38, #ffd25f);
+  filter: drop-shadow(0 0 0.375rem rgba(255, 90, 20, 0.65));
+}
+
+.dg-avatar-frame--green {
+  background: conic-gradient(from 0deg, #a8ff60, #3ddc84, #0f9d58, #a8ff60);
+  filter: drop-shadow(0 0 0.375rem rgba(61, 220, 132, 0.6));
+}
+
+.dg-avatar-frame--holographic_glass_ring {
+  background: conic-gradient(
+    from 0deg,
+    #ff9de2, #9d7bff, #63e6ff, #a8ff9e, #ffe38f, #ff9de2
+  );
+  filter: drop-shadow(0 0 0.5rem rgba(157, 123, 255, 0.6));
+  animation-duration: 5s;
+}
+
+.dg-avatar-frame--liquid_chrome_ring {
+  background: conic-gradient(
+    from 0deg,
+    #f6f9ff, #9ba6b8, #ffffff, #5d6571, #dfe7f2, #f6f9ff
+  );
+  filter: drop-shadow(0 0 0.375rem rgba(220, 232, 255, 0.55));
+  animation-duration: 9s;
+}
+
+@keyframes dg-frame-spin {
+  from {
+    transform: rotate(0deg);
+  }
+
+  to {
+    transform: rotate(360deg);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .dg-avatar-frame {
+    animation: none;
+  }
+}
