diff --git a/src/util/deltagram/prefs.ts b/src/util/deltagram/prefs.ts
new file mode 100644
index 0000000..9ff5484
--- /dev/null
+++ b/src/util/deltagram/prefs.ts
@@ -0,0 +1,98 @@
+// DeltaGram web preferences. These mirror the most visible options of the
+// Android DeltaGram settings: interface scale, bubble radius, seconds in
+// message time and iOS-like motion. Everything is stored locally and applied
+// without a reload.
+
+export type DeltagramPrefs = {
+  uiScale: number;
+  bubbleRadius: number;
+  seconds: boolean;
+  iosMotion: boolean;
+};
+
+const STORAGE_KEY = 'deltagram:prefs:v1';
+
+export const DELTAGRAM_PREFS_DEFAULTS: DeltagramPrefs = {
+  uiScale: 100,
+  bubbleRadius: 16,
+  seconds: false,
+  iosMotion: false,
+};
+
+let cached: DeltagramPrefs | undefined;
+
+export function getDeltagramPrefs(): DeltagramPrefs {
+  if (cached) return cached;
+  try {
+    const raw = localStorage.getItem(STORAGE_KEY);
+    const parsed = raw ? JSON.parse(raw) as Partial<DeltagramPrefs> : {};
+    cached = { ...DELTAGRAM_PREFS_DEFAULTS, ...parsed };
+  } catch {
+    cached = { ...DELTAGRAM_PREFS_DEFAULTS };
+  }
+  return cached;
+}
+
+let reloadTimer: number | undefined;
+
+export function setDeltagramPrefs(patch: Partial<DeltagramPrefs>) {
+  const previous = getDeltagramPrefs();
+  cached = { ...previous, ...patch };
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(cached));
+  } catch {
+    // Private mode can reject storage; keep the in-memory value.
+  }
+  applyDeltagramPrefs();
+  window.dispatchEvent(new CustomEvent('deltagram:prefs'));
+
+  // Telegram Web snapshots its responsive breakpoints at boot (matchMedia) and
+  // keeps column measurements in module state. Reloading after a scale change
+  // rebuilds them against the new scale; other options apply live.
+  if (cached && previous.uiScale !== cached.uiScale) {
+    window.clearTimeout(reloadTimer);
+    reloadTimer = window.setTimeout(() => window.location.reload(), 700);
+  }
+}
+
+export function applyDeltagramPrefs() {
+  const prefs = getDeltagramPrefs();
+  const body = document.body;
+  if (body) {
+    // CSS zoom scales px and rem alike, so the whole Telegram layout grows.
+    const zoom = prefs.uiScale === 100 ? '' : String(prefs.uiScale / 100);
+    if (body.style.zoom !== zoom) {
+      body.style.zoom = zoom;
+      // Telegram Web measures the column widths in JS. A zoom change does not
+      // fire `resize`, so without this the panels keep stale sizes and the
+      // layout visibly shifts; notify after the new layout is committed.
+      requestAnimationFrame(() => window.dispatchEvent(new Event('resize')));
+      // Telegram Web also memoises column measurements; one more tick after
+      // React commits the zoomed layout keeps menus and panels aligned.
+      window.setTimeout(() => window.dispatchEvent(new Event('resize')), 200);
+    }
+  }
+  const root = document.documentElement;
+  root.style.setProperty('--border-radius-messages', `${prefs.bubbleRadius}px`);
+  root.classList.toggle('dg-ios-motion', prefs.iosMotion);
+  root.dataset.dgSeconds = prefs.seconds ? '1' : '0';
+}
+
+export function subscribeDeltagramPrefs(listener: () => void) {
+  window.addEventListener('deltagram:prefs', listener);
+  return () => window.removeEventListener('deltagram:prefs', listener);
+}
+
+// Scale the pixel-based responsive breakpoints with the interface scale, so a
+// 120 % layout collapses columns exactly like a browser zoom would. This must
+// run before Telegram Web initialises its media query cache.
+(function patchMatchMedia() {
+  if (typeof window === 'undefined' || typeof window.matchMedia !== 'function') return;
+  const original = window.matchMedia.bind(window);
+  window.matchMedia = (query: string) => {
+    const scale = getDeltagramPrefs().uiScale / 100;
+    if (scale === 1) return original(query);
+    const scaled = query.replace(/(\d+(?:\.\d+)?)px/g, (_, n: string) => `${Math.round(Number(n) * scale)}px`);
+    return original(scaled);
+  };
+})();
diff --git a/src/util/deltagram/registry.ts b/src/util/deltagram/registry.ts
new file mode 100644
index 0000000..8da6b59
--- /dev/null
+++ b/src/util/deltagram/registry.ts
@@ -0,0 +1,103 @@
+// Public DeltaGram registries: avatar frames (`/api/frames/registry`) and
+// profile banners (`/api/banners/registry`). Both are served by the deltament
+// backend on the same origin, so no CORS setup is needed.
+
+import { useEffect, useState } from '../../lib/teact/teact';
+
+const FRAMES_URL = '/api/frames/registry';
+const BANNERS_URL = '/api/banners/registry';
+const CACHE_TTL = 5 * 60 * 1000;
+
+type Registry = Record<string, string>;
+
+type RegistryState = {
+  data: Registry;
+  loadedAt: number;
+  promise?: Promise<void>;
+  listeners: Set<() => void>;
+};
+
+const frames: RegistryState = { data: {}, loadedAt: 0, listeners: new Set() };
+const banners: RegistryState = { data: {}, loadedAt: 0, listeners: new Set() };
+
+function notify(state: RegistryState) {
+  state.listeners.forEach((listener) => listener());
+}
+
+async function refresh(state: RegistryState, url: string, key: string) {
+  if (state.promise) return state.promise;
+  state.promise = (async () => {
+    try {
+      const response = await fetch(url, { cache: 'no-store' });
+      if (!response.ok) return;
+      const body = await response.json() as Record<string, Registry> | undefined;
+      const list = body?.[key];
+      if (list && typeof list === 'object') {
+        state.data = list;
+      }
+      state.loadedAt = Date.now();
+      notify(state);
+    } catch {
+      // Registry is optional decoration: ignore network failures.
+    } finally {
+      state.promise = undefined;
+    }
+  })();
+  return state.promise;
+}
+
+function ensure(state: RegistryState, url: string, key: string) {
+  if (Date.now() - state.loadedAt < CACHE_TTL) return Promise.resolve();
+  return refresh(state, url, key);
+}
+
+export function getDeltagramFrameKind(userId?: string) {
+  if (!userId) return undefined;
+  return frames.data[userId];
+}
+
+export function getDeltagramBannerUrl(userId?: string) {
+  if (!userId) return undefined;
+  const token = banners.data[userId];
+  if (!token) return undefined;
+  return `/api/banners/${userId}?v=${token}`;
+}
+
+function useRegistryValue(state: RegistryState, url: string, key: string, userId?: string) {
+  const read = () => (key === 'frames' ? getDeltagramFrameKind(userId) : getDeltagramBannerUrl(userId));
+  const [value, setValue] = useState(read);
+
+  useEffect(() => {
+    if (!userId) {
+      setValue(undefined);
+      return undefined;
+    }
+    let alive = true;
+    const update = () => {
+      if (alive) setValue(read());
+    };
+    state.listeners.add(update);
+    void ensure(state, url, key).then(update);
+    update();
+    return () => {
+      alive = false;
+      state.listeners.delete(update);
+    };
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [userId, url, key]);
+
+  return value;
+}
+
+export function prefetchDeltagramRegistries() {
+  void ensure(frames, FRAMES_URL, 'frames');
+  void ensure(banners, BANNERS_URL, 'banners');
+}
+
+export function useDeltagramFrame(userId?: string) {
+  return useRegistryValue(frames, FRAMES_URL, 'frames', userId);
+}
+
+export function useDeltagramBanner(userId?: string) {
+  return useRegistryValue(banners, BANNERS_URL, 'banners', userId);
+}
