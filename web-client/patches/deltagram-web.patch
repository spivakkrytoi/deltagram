diff --git a/src/api/gramjs/methods/settings.ts b/src/api/gramjs/methods/settings.ts
index 1bac1b6..2380d44 100644
--- a/src/api/gramjs/methods/settings.ts
+++ b/src/api/gramjs/methods/settings.ts
@@ -455,6 +455,19 @@ export function updateNotificationSettings(peerType: ApiNotifyPeerType, {
   }));
 }
 
+
+function rebrandLangStrings(strings: Record<string, string>) {
+  const out: Record<string, string> = {};
+  for (const [key, value] of Object.entries(strings)) {
+    if (typeof value === 'string' && !value.includes('://') && !value.includes('t.me/')) {
+      out[key] = value.replace(/\bTelegram\b/g, 'DeltaGram');
+    } else {
+      out[key] = value;
+    }
+  }
+  return out;
+}
+
 export async function fetchLangPack({
   langPack,
   langCode,
@@ -476,7 +489,7 @@ export async function fetchLangPack({
     langCode: result.langCode,
     fromVersion: result.fromVersion,
     version: result.version,
-    strings,
+    strings: rebrandLangStrings(strings),
     keysToRemove,
   };
 }
@@ -505,7 +518,7 @@ export async function fetchLangDifference({
     langCode: result.langCode,
     fromVersion: result.fromVersion,
     version: result.version,
-    strings,
+    strings: rebrandLangStrings(strings),
     keysToRemove,
   };
 }
