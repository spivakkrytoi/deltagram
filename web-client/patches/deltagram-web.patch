+import { memo, useState } from '../../../lib/teact/teact';
+
+import { DELTAGRAM_PREFS_DEFAULTS, getDeltagramPrefs, setDeltagramPrefs } from '../../../util/deltagram/prefs';
+import { resetDateFormatCache } from '../../../util/localization/dateFormat';
+import useHistoryBack from '../../../hooks/useHistoryBack';
+
+import Checkbox from '../../ui/Checkbox';
+import RangeSlider from '../../ui/RangeSlider';
+import Island from '../../gili/layout/Island';
+import ListItem from '../../ui/ListItem';
+
+type OwnProps = {
+  isActive?: boolean;
+  onReset: () => void;
+};
+
+/**
+ * DeltaGram settings for the web client. Mirrors the Android hub: interface
+ * scale, bubble radius, seconds and motion, plus links to the native builds.
+ */
+const SettingsDeltaGram = ({ isActive, onReset }: OwnProps) => {
+  const [prefs, setPrefs] = useState(getDeltagramPrefs);
+
+  useHistoryBack({
+    isActive,
+    onBack: onReset,
+  });
+
+  const update = (patch: Parameters<typeof setDeltagramPrefs>[0]) => {
+    setDeltagramPrefs(patch);
+    setPrefs(getDeltagramPrefs());
+  };
+
+  const handleSeconds = (checked: boolean) => {
+    resetDateFormatCache();
+    update({ seconds: checked });
+  };
+
+  return (
+    <div className="settings-content custom-scroll">
+      <div className="settings-content-header no-border">
+        <h3 className="settings-item-header">DeltaGram</h3>
+        <p className="settings-item-description" dir="auto">
+          Настройки веб-клиента DeltaGram. Часть функций APK (свайпы, двойной тап,
+          выбор иконки приложения) относится только к мобильному клиенту.
+        </p>
+      </div>
+
+      <Island>
+        <div className="settings-item">
+          <RangeSlider
+            label="Масштаб интерфейса"
+            min={80}
+            max={130}
+            step={5}
+            value={prefs.uiScale}
+            renderValue={(value) => `${value}%`}
+            onChange={(value) => update({ uiScale: value })}
+          />
+        </div>
+        <div className="settings-item">
+          <RangeSlider
+            label="Радиус пузырей сообщений"
+            min={0}
+            max={20}
+            step={1}
+            value={prefs.bubbleRadius}
+            renderValue={(value) => `${value} px`}
+            onChange={(value) => update({ bubbleRadius: value })}
+          />
+        </div>
+      </Island>
+
+      <Island>
+        <Checkbox
+          label="Показывать секунды в сообщениях"
+          checked={prefs.seconds}
+          onCheck={handleSeconds}
+        />
+        <Checkbox
+          label="iOS-подобные анимации и стекло"
+          checked={prefs.iosMotion}
+          onCheck={(checked) => update({ iosMotion: checked })}
+        />
+      </Island>
+
+      <Island>
+        <ListItem
+          icon="download"
+          href="/downloads/DeltaGram-dg15-20261128.apk"
+        >
+          <div className="title">Скачать APK для Android</div>
+        </ListItem>
+        <ListItem
+          icon="device-windows"
+          href="/downloads/DeltaGram-win64-20261126.zip"
+        >
+          <div className="title">Скачать DeltaGram для Windows</div>
+        </ListItem>
+        <ListItem
+          icon="reload"
+          onClick={() => update(DELTAGRAM_PREFS_DEFAULTS)}
+        >
+          <div className="title">Сбросить настройки DeltaGram</div>
+        </ListItem>
+      </Island>
+    </div>
+  );
+};
+
+export default memo(SettingsDeltaGram);
