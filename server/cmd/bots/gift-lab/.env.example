# New, dedicated bot token from @BotFather. Never reuse an admin or store bot token.
GIFT_LAB_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot and Mini App.
GIFT_LAB_OWNER_IDS=
# DeltaGram username that receives issued gifts (without @).
GIFT_LAB_GRANT_USERNAME=owner
# Numeric fallback when GIFT_LAB_GRANT_USERNAME is empty.
GIFT_LAB_GRANT_USER_ID=
# Public HTTPS URL of this app (must be HTTPS for Telegram Mini Apps).
GIFT_LAB_PUBLIC_URL=https://dltagram.duckdns.org/gift-lab/
GIFT_LAB_LISTEN=127.0.0.1
GIFT_LAB_PORT=2810
# Internal admin API used to list gifts and issue collectibles.
GIFT_LAB_ADMIN_API=http://127.0.0.1:2599
GIFT_LAB_ADMIN_TOKEN=
